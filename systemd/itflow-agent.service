[Unit]
Description=ITFlow Linux asset synchronization agent
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/itflow-agent/venv/bin/itflow-agent --config /etc/itflow-agent/config.toml
LoadCredential=itflow_api_key:/etc/itflow-agent/api-key
StateDirectory=itflow-agent
StateDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
